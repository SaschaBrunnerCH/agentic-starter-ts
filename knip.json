{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "index.html",
    "src/**/*.test.{ts,tsx}",
    "scripts/**/*.test.ts",
    "scripts/{issue,task,release,setup-github,setup-previews,install-hooks,pre-push,run-local-checks,test-devices}.ts",
    "scripts/check-*.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "scripts/**/*.ts", "e2e/**/*.ts"],
  "ignoreDependencies": ["@secretlint/secretlint-rule-preset-recommend"],
  "ignoreBinaries": ["ssh-keygen", "Xvfb"]
}
