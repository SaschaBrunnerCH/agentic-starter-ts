{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "index.html",
    "src/**/*.test.{ts,tsx}",
    "scripts/**/*.test.ts",
    "scripts/workflow/{issue,task,heavy,heavy-supervisor,heavy-group,init-local-artifacts}.ts",
    "scripts/setup/{setup-github,setup-previews}.ts",
    "scripts/git/{install-hooks,pre-push,check-commit-message}.ts",
    "scripts/checks/{run-local-checks,check-*}.ts",
    "scripts/browser/{test-devices,check-browser-environment,browser-doctor}.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "scripts/**/*.ts", "e2e/**/*.ts"],
  "ignoreDependencies": ["@secretlint/secretlint-rule-preset-recommend"],
  "ignoreBinaries": ["ssh-keygen", "Xvfb"]
}
