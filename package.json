{
  "name": "agentic-starter-ts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "prepare": "node scripts/install-hooks.ts",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:staged": "lint-staged --concurrent false",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:browser": "playwright test --project chromium",
    "test:browser:install": "playwright install --with-deps chromium",
    "test:devices": "node scripts/test-devices.ts",
    "check:unused": "node scripts/check-unused.ts",
    "check:secrets": "node scripts/check-secrets.ts",
    "check:workflows": "node scripts/check-workflows.ts",
    "check:agents": "node scripts/check-agent-entry-points.ts",
    "check:links": "node scripts/check-links.ts",
    "check:dependencies": "node scripts/check-dependencies.ts",
    "check:bundle": "node scripts/check-bundle.ts",
    "check:hooks": "node scripts/install-hooks.ts --check",
    "check:audit": "pnpm audit --prod --audit-level high",
    "check:push": "node scripts/run-local-checks.ts",
    "setup:github": "node scripts/setup-github.ts",
    "setup:previews": "node scripts/setup-previews.ts",
    "issue": "node scripts/issue.ts",
    "task": "node scripts/task.ts",
    "release": "node scripts/release.ts"
  },
  "lint-staged": {
    "*.{cjs,cts,js,jsx,mjs,mts,ts,tsx}": "oxlint --fix --deny-warnings",
    "*": [
      "prettier --write --ignore-unknown",
      "secretlint --no-glob"
    ]
  },
  "prettier": {
    "printWidth": 100
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "^1.64.0",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.4",
    "knip": "^6.41.0",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2003",
    "prettier": "^3.9.10",
    "secretlint": "^13.0.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
