{
  "name": "agentic-starter-ts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "prepare": "node scripts/git/install-hooks.ts",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:staged": "lint-staged --concurrent false",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:browser": "node --import ./scripts/browser/playwright-browsers-env.ts scripts/browser/browser-test.ts",
    "test:browser:install": "node --import ./scripts/browser/playwright-browsers-env.ts scripts/browser/browser-test-cli.ts install --with-deps chromium",
    "test:devices": "node --import ./scripts/browser/playwright-browsers-env.ts scripts/browser/test-devices.ts",
    "check:unused": "node scripts/checks/check-unused.ts",
    "check:secrets": "node scripts/checks/check-secrets.ts",
    "check:workflows": "node scripts/checks/check-workflows.ts",
    "check:agents": "node scripts/checks/check-agent-entry-points.ts",
    "check:links": "node scripts/checks/check-links.ts",
    "check:dependencies": "node scripts/checks/check-dependencies.ts",
    "check:bundle": "node scripts/checks/check-bundle.ts",
    "check:hooks": "node scripts/git/install-hooks.ts --check",
    "check:audit": "pnpm audit --prod --audit-level high",
    "check:adoption": "node scripts/checks/check-adoption.ts",
    "check:push": "node scripts/checks/run-local-checks.ts",
    "setup:github": "node scripts/setup/setup-github.ts",
    "setup:previews": "node scripts/setup/setup-previews.ts",
    "issue": "node scripts/workflow/issue.ts",
    "local:init": "node scripts/workflow/init-local-artifacts.ts",
    "task": "node scripts/workflow/task.ts",
    "release": "node scripts/release/release.ts",
    "browser:doctor": "node --import ./scripts/browser/playwright-browsers-env.ts scripts/browser/browser-doctor.ts",
    "browser:cli": "node --import ./scripts/browser/playwright-browsers-env.ts scripts/browser/browser-test-cli.ts",
    "browser:check": "node --import ./scripts/browser/playwright-browsers-env.ts scripts/browser/check-browser-environment.ts"
  },
  "lint-staged": {
    "*.{cjs,cts,js,jsx,mjs,mts,ts,tsx}": "oxlint --fix --deny-warnings",
    "*": [
      "prettier --write --ignore-unknown",
      "secretlint --no-glob"
    ]
  },
  "prettier": {
    "printWidth": 100
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "^1.64.0",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.4",
    "knip": "^6.41.0",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2003",
    "prettier": "^3.9.10",
    "secretlint": "^13.0.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
